---
import { developerTools } from '../data/projects';
type Props = { slug: string; compact?: boolean };
const { slug, compact = false } = Astro.props;
---
<div class:list={['project-visual', `visual-${slug}`, { compact }]} aria-hidden="true">
  {slug === 'cloudgateway' && <><div class="visual-grid"></div><span class="visual-caption">WEB, IOS & MACOS</span><div class="cloud-desktop"><div class="window-bar"><i></i><i></i><i></i><span>CloudGateway</span></div><img src="/images/cloudgateway-web.webp" width="1050" height="942" alt="" loading="lazy" /></div><img class="cloud-phone" src="/images/cloudgateway-ios.webp" width="430" height="932" alt="" loading="lazy" /><span class="visual-note"><i></i> WEB · MACOS · IOS · CLI</span></>}
  {slug === 'streamtrack' && <><span class="visual-caption">REACT NATIVE APP</span><div class="phone-trio"><img src="/images/streamtrack-details.webp" width="430" height="932" alt="" loading="lazy" /><img src="/images/streamtrack-discover.webp" width="430" height="932" alt="" loading="lazy" /><img src="/images/streamtrack-library.webp" width="430" height="932" alt="" loading="lazy" /></div><span class="visual-note">STREAMTRACK</span></>}
  {slug === 'shelf' && <><span class="visual-caption">LIBRARY BOOK SEARCH</span><div class="shelf-desktop"><div class="window-bar"><i></i><i></i><i></i><span>Shelf</span></div><img src="/images/shelf-web.webp" alt="" loading="lazy" /></div><img class="shelf-phone" src="/images/shelf-mobile.webp" alt="" loading="lazy" /></>}
  {slug === 'ai-developer-tools' && <><span class="visual-caption">AI &amp; DEVELOPER TOOLS</span><div class="toolkit-art">{developerTools.map(tool => <span>{tool.name}</span>)}</div><span class="visual-note">CLI · CHROME CDP · MCP</span></>}
  {slug === 'the-catch' && <><span class="visual-caption">REACT NATIVE · FIREBASE</span><div class="phone-trio"><img src="/images/catch-chat.webp" alt="" loading="lazy" /><img src="/images/catch-home.webp" alt="" loading="lazy" /><img src="/images/catch-registration.webp" alt="" loading="lazy" /></div><span class="visual-note">TIED FOR FIRST PLACE IN CLASS</span></>}
  {slug === 'clipboard-history' && <><span class="visual-caption">MACOS CLIPBOARD MANAGER</span><div class="clipboard-art"><span class="clip-outline clip-back"></span><span class="clip-outline clip-front"><svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2"><rect x="17" y="16" width="32" height="39" rx="4"/><path d="M25 16v-4h16v4M25 29h16M25 37h16M25 45h9"/></svg></span><kbd>⌘</kbd><kbd>⇧</kbd><kbd>V</kbd></div><span class="visual-note">SWIFT · NATIVE MACOS</span></>}
  {slug === 'codelaunch' && <><span class="visual-caption">REMOTE DEVELOPMENT</span><div class="codelaunch-screen"><div class="window-bar"><i></i><i></i><i></i><span>CodeLaunch</span></div><img src="/images/codelaunch-desktop.webp" width="1050" height="700" alt="" loading="lazy" /></div><img class="codelaunch-phone" src="/images/codelaunch-mobile.webp" width="430" height="932" alt="" loading="lazy" /><span class="visual-note">DESKTOP & MOBILE</span></>}
  {slug === 'br0wser' && <><span class="visual-caption">BROWSER AUTOMATION</span><div class="terminal-art"><div class="terminal-label"><i></i><i></i><i></i><span>br0wser</span></div><code><span class="prompt">~ $</span> br0wser open<br /><span class="terminal-dim">// Chrome DevTools Protocol</span><br /><span class="prompt">~ $</span> br0wser info<br /><span class="terminal-cursor">▌</span></code></div></>}
  {slug === 't3-thread' && <><span class="visual-caption">CONVERSATION RETRIEVAL</span><div class="thread-art"><span>{'{'}<br />&nbsp; <b>"format"</b>: <em>"jsonl"</em>,<br />&nbsp; <b>"mode"</b>: <em>"read-only"</em><br />{'}'}</span><div class="thread-line"><i></i><i></i><i></i><i></i></div></div></>}
</div>
