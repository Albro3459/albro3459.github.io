    "inspect:layout": "node scripts/layout-review.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  }
