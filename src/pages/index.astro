---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ProjectVisual from '../components/ProjectVisual.astro';
import { featuredProjects } from '../data/projects';
const experience = [
  { company: 'Marucci Sports', role: 'Full-Stack Web Developer', date: 'AUG 2025 — PRESENT', detail: 'Building production applications for warranty operations and real-time shop-floor workflows with Angular, NestJS, TypeScript, and SQL.' },
  { company: 'Louisiana Office of Technology Services', role: 'Software Developer Intern', date: 'JAN 2024 — MAY 2025', detail: 'Developed .NET web applications and REST APIs. Built a GitHub Actions pipeline with Cypress, bringing coverage from 0% to approximately 85%.' },
  { company: 'Deloitte Consulting', role: 'Solutions Engineer Intern', date: 'JUN — JUL 2024', detail: 'Worked on Java and Spring Boot APIs and built a Python generative AI prototype that turned meeting summaries into RFP documents in under two minutes.' },
  { company: 'We Greaux People', role: 'Software Developer Intern', date: 'SEP — NOV 2023', detail: 'Contributed to a Flutter frontend and expanded unit, integration, and widget coverage from approximately 25% to 75%.' },
  { company: 'McIlhenny Company / Tabasco', role: 'Software Analyst Intern', date: 'MAY — JUL 2023', detail: 'Automated concurrent request reporting with shell scripts and SQL on AIX UNIX, saving 30–50 hours each month.' },
];
---
<Layout>
  <section class="hero shell" aria-labelledby="hero-heading">
    <div class="hero-main">
      <div class="hero-copy">
        <h1 id="hero-heading">Alexander Brodsky</h1>
        <p>Full-Stack Software Engineer at Marucci Sports and M.S. Computer Science student at Georgia Tech. Experience building web applications, mobile apps, and cloud infrastructure.</p>
        <div class="hero-ctas"><a class="button button-primary" href="/Alex-Brodsky-Resume.pdf" target="_blank">View resume <Icon size={17} /></a><a class="text-link" href="#work">View projects <Icon name="down" size={16} /></a></div>
      </div>
      <dl class="hero-details">
        <div><dt>Current role</dt><dd>Full-Stack Web Developer<span>Marucci Sports · August 2025–present</span></dd></div>
        <div><dt>Education</dt><dd>M.S. Computer Science<span>Georgia Tech · AI specialization</span></dd></div>
        <div><dt>Links</dt><dd class="hero-profile-links"><a href="https://github.com/Albro3459" target="_blank" rel="noreferrer">GitHub <Icon size={14} /></a><a href="https://www.linkedin.com/in/brodsky-alex22/" target="_blank" rel="noreferrer">LinkedIn <Icon size={14} /></a></dd></div>
      </dl>
    </div>
  </section>

  <section id="experience" class="experience-section shell" aria-labelledby="experience-heading"><div class="section-heading" data-reveal><div><h2 id="experience-heading">Experience</h2></div><a class="text-link" href="/Alex-Brodsky-Resume.pdf" target="_blank">View resume <Icon size={17} /></a></div><div class="experience-list">{experience.map(job => <details class="experience-item" open data-reveal><summary><span class="experience-date">{job.date}</span><span class="experience-company">{job.company}<span>{job.role}</span></span><span class="experience-expand" aria-hidden="true">+</span></summary><p>{job.detail}</p></details>)}</div></section>

  <section id="about" class="about-section" aria-labelledby="about-heading">
    <div class="shell about-grid">
      <div class="about-title" data-reveal><h2 id="about-heading">Education &amp; skills</h2></div>
      <div class="about-copy" data-reveal>
        <div class="education">
          <div><span class="eyebrow">GEORGIA TECH</span><strong>M.S. Computer Science</strong><span>AI specialization · Expected May 2028</span><span>GPA: 4.0</span></div>
          <div><span class="eyebrow">LOUISIANA STATE UNIVERSITY</span><strong>B.S. Computer Science</strong><span>Mathematics minor · May 2025</span><span>GPA: 3.6</span></div>
        </div>
        <div class="skill-groups">
          <div><h3>Languages</h3><p>TypeScript, JavaScript, C#, Python, Swift, Java, SQL, Shell</p></div>
          <div><h3>Frameworks</h3><p>React, React Native, Angular, NestJS, .NET, Spring Boot</p></div>
          <div><h3>Cloud &amp; databases</h3><p>AWS, Oracle Cloud, Google Cloud, PostgreSQL, SQL Server, Firebase</p></div>
        </div>
      </div>
    </div>
  </section>

  <section id="work" class="work-section shell" aria-labelledby="work-heading">
    <div class="section-heading" data-reveal><div><h2 id="work-heading">Projects</h2></div></div>
    <div class="work-toolbar"><div class="project-filters" role="group" aria-label="Filter projects"><button type="button" data-filter="All" aria-pressed="true">All projects</button><button type="button" data-filter="Applications" aria-pressed="false">Applications</button><button type="button" data-filter="Developer tools" aria-pressed="false">Developer tools</button></div></div>
    <div class="projects-grid">{featuredProjects.map((project, index) => <article class:list={['project-card', { 'small-project': index > 3 }]} data-category={project.category} data-reveal><a class="project-image-link" href={`/projects/${project.slug}/`} tabindex="-1" aria-hidden="true"><ProjectVisual slug={project.slug} compact={index > 3} /><span class="project-image-arrow"><Icon size={23} /></span></a><div class="project-info"><span class="eyebrow project-kind">{project.kind}</span><h3><a href={`/projects/${project.slug}/`}>{project.name}<Icon size={24} /></a></h3><p>{project.description}</p><ul class="tags" aria-label="Technologies">{project.tags.map(tag => <li>{tag}</li>)}</ul></div></article>)}</div>
    <article class="project-mention" data-category="Applications" data-reveal>
      <div class="project-mention-main"><img class="project-app-icon" src="/images/wordle-icon.svg" alt="" width="80" height="80" loading="lazy" /><div><span class="eyebrow">CHROME EXTENSION</span><h3>Wordle Archive Navigation</h3><p>Adds previous and next day controls to the Wordle archive.</p></div></div>
      <div class="project-mention-links"><a class="text-link" href="https://chromewebstore.google.com/detail/wordle-archive-navigation/cbpfglhkldenokgjofgpddhcpbhaijgi" target="_blank" rel="noreferrer">Chrome Web Store <Icon size={16} /></a><a class="text-link" href="https://github.com/Albro3459/WordleExtension" target="_blank" rel="noreferrer">View source <Icon name="github" size={16} /></a></div>
    </article>
    <a class="all-github text-link" href="https://github.com/Albro3459?tab=repositories" target="_blank" rel="noreferrer">All repositories on GitHub <Icon name="github" size={18} /><Icon size={16} /></a>
  </section>

  <section id="contact" class="contact-section shell" aria-labelledby="contact-heading">
    <div class="contact-inner" data-reveal>
      <div class="contact-main"><div><h2 id="contact-heading">Contact</h2><p>For job opportunities, contact me by email or LinkedIn.</p></div><div class="contact-actions"><a class="button button-primary" href="mailto:brodsky.alex22@gmail.com">Email me <Icon name="mail" size={18} /></a><a class="button button-outline" href="https://www.linkedin.com/in/brodsky-alex22/" target="_blank" rel="noreferrer">LinkedIn <Icon size={18} /></a></div></div>
      <div class="contact-bottom"><a href="mailto:brodsky.alex22@gmail.com">brodsky.alex22@gmail.com</a><button type="button" class="copy-email" aria-label="Copy email address"><Icon name="copy" size={16} /><span>Copy email</span></button><span class="copy-status" role="status"></span></div>
    </div>
  </section>
  <script>
    const filters = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const cards = document.querySelectorAll<HTMLElement>('[data-category]');
    filters.forEach(button => button.addEventListener('click', () => {
      filters.forEach(filter => filter.setAttribute('aria-pressed', String(filter === button)));
      cards.forEach(card => { card.hidden = button.dataset.filter !== 'All' && card.dataset.category !== button.dataset.filter; if (!card.hidden) { card.classList.add('is-visible'); } });
    }));
    document.querySelector('.copy-email')?.addEventListener('click', async () => {
      const status = document.querySelector('.copy-status');
      try { await navigator.clipboard.writeText('brodsky.alex22@gmail.com'); if (status) status.textContent = 'Copied!'; }
      catch { if (status) status.textContent = 'Email: brodsky.alex22@gmail.com'; }
    });
  </script>
</Layout>
